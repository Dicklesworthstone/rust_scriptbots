{
  "name": "03_malformed_arguments_string_non_json",
  "description": "Tool call input arguments provided as unparseable raw string rather than JSON object",
  "turns": [
    {
      "body": {
        "id": "msg_1",
        "usage": { "input_tokens": 10, "output_tokens": 5 },
        "stop_reason": "tool_use",
        "content": [
          {
            "type": "tool_use",
            "name": "propose_experiment",
            "input": "NOT_A_JSON_OBJECT"
          }
        ]
      }
    }
  ],
  "expect": {
    "terminates": true,
    "max_runs_spent": 0,
    "expected_error_substring": "string that is not JSON",
    "must_not": [
      "panic",
      "budget_overrun",
      "write_outside_session_dir",
      "process_spawn"
    ]
  }
}
