{
  "name": "04_malformed_tool_no_args",
  "description": "Tool call block is missing input arguments entirely",
  "turns": [
    {
      "body": {
        "id": "msg_1",
        "usage": { "input_tokens": 10, "output_tokens": 5 },
        "stop_reason": "tool_use",
        "content": [
          {
            "type": "tool_use",
            "name": "propose_experiment"
          }
        ]
      }
    }
  ],
  "expect": {
    "terminates": true,
    "max_runs_spent": 0,
    "expected_error_substring": "has no arguments",
    "must_not": ["panic", "budget_overrun", "write_outside_session_dir", "process_spawn"]
  }
}
